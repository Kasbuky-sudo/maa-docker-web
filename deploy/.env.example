# MAA Docker Web environment
# Copy to .env next to docker-compose.yml and adjust.

# Published web port on the host
WEB_PORT=8080

# Image tag (latest, v0.1.0, ...)
VERSION=latest

# Timezone
TZ=Asia/Shanghai

# Server log level: debug | info | warn | error
LOG_LEVEL=info

# Download the official MAA runtime automatically on first boot (true/false)
# When false, trigger POST /api/runtime/fetch from the web UI.
AUTO_FETCH_RUNTIME=true

# Optional egress proxy for the MAA runtime download (GitHub Releases)
# Example for a local accelerator: http://192.168.31.87:7890
HTTP_PROXY=
HTTPS_PROXY=
